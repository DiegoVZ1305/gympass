# Solo el código listo para desplegar la plataforma en Namecheap.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/app.js
!/package.json
!/package-lock.json
!/server/
!/lib/
!/scripts/
!/dist/
!/src/
!/public/
!/tests/
!/docs/
!/web-releases/
!/index.html
!/vite.config.ts
!/tsconfig.json
!/vendor/
!/client-releases/

# Dependencias, datos y credenciales se conservan fuera de Git.
**/node_modules/
**/.env
**/.env.*
**/data/
**/platform-data/
**/platform-backups/
**/backups/
**/output/
**/.cache-artifacts/
**/*.sqlite*
**/*.db
**/*.db-*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/activation-secret.*
**/activation.json
**/credentials.json
**/credentials.key

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/verify.yml

!/instaladores/
!/instaladores/5.7.0/
!/instaladores/5.7.0/GymPASS-Android-5.7.0.apk
!/instaladores/5.7.0/GymPASS-Setup-5.7.0.exe
/instaladores/5.7.0/GymPASS-Portable-5.7.0.exe
/instaladores/5.7.0/GymPASS-Setup-5.7.0.exe.blockmap
