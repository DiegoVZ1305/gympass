+.support-contacts { display: grid; gap: 12px; margin-top: 20px; }
+.support-contact {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 16px;
+  border: 1px solid var(--border-strong);
+  border-radius: var(--r-md);
+  color: var(--ink);
