+.support-contact > svg:last-child { margin-left: auto; flex-shrink: 0; color: var(--muted); }
+.support-contact strong, .support-contact small { display: block; }
+.support-contact small { margin-top: 4px; color: var(--muted); }
+.support-contact:focus-visible, .support-trigger:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
