+  let release!: () => void;
+  const held = f.app.tenants.withHeavyOperation(() => new Promise<void>(done => { release = done; }));
+  let restore!: () => void;
+  await f.app.tenants.withTenant(f.gym, async ctx => {
+    const prepare = ctx.db.raw.prepare;
